{
  "name": "repro-in-a-box",
  "version": "2.8.1",
  "description": "Production-grade automated bug detection with 12 detectors and a plugin API. Find bugs with Playwright, record HAR files, validate reproducibility, and integrate with Claude Desktop via MCP.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "repro": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "action.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "mcp": "node dist/mcp/index.js",
    "lint": "eslint src/**/*.ts tests/**/*.ts",
    "lint:fix": "eslint src/**/*.ts tests/**/*.ts --fix",
    "biome:check": "biome check .",
    "biome:fix": "biome check . --write",
    "biome:format": "biome format . --write"
  },
  "keywords": [
    "qa",
    "testing",
    "playwright",
    "bug-detection",
    "mcp",
    "har",
    "reproducibility",
    "accessibility",
    "web-vitals",
    "automation"
  ],
  "author": "forbiddenlink",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/forbiddenlink/repro-in-a-box.git"
  },
  "bugs": {
    "url": "https://github.com/forbiddenlink/repro-in-a-box/issues"
  },
  "homepage": "https://github.com/forbiddenlink/repro-in-a-box#readme",
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/test": "^1.62.1",
    "@types/adm-zip": "^0.5.7",
    "adm-zip": "^0.6.0",
    "axe-playwright": "^2.2.2",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "inquirer": "^14.1.0",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "web-vitals": "^6.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/inquirer": "^9.0.10",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^10.9.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "private": false,
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1",
      "flatted": ">=3.4.2",
      "hono": ">=4.12.34",
      "fast-uri": ">=3.1.5",
      "ip-address": ">=10.3.1",
      "lodash": ">=4.18.0",
      "minimatch": ">=9.0.7",
      "nanoid": ">=3.3.18",
      "next": ">=16.2.3",
      "path-to-regexp": ">=8.4.0",
      "picomatch": ">=4.0.4",
      "postcss": ">=8.5.3",
      "rollup": ">=4.59.0",
      "vite": ">=6.4.2",
      "ws": ">=8.18.2"
    }
  },
  "packageManager": "pnpm@10.32.1"
}
